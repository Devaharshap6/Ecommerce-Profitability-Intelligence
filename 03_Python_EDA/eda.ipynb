{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Python EDA — E-commerce Profitability\n","\n","This notebook is intentionally lightweight. SQL performs the relational investigation; Python is used for distribution checks, outliers and RFM analysis."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import pandas as pd\n","import matplotlib.pyplot as plt\n","from sqlalchemy import create_engine\n","\n","# Set your local PostgreSQL password before running.\n","engine = create_engine(\n","    'postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5433/ecommerce_profitability'\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["query = '''\n","SELECT oi.order_id, oi.product_id, oi.seller_id, o.customer_id,\n","       o.order_status, o.order_purchase_timestamp,\n","       oi.price AS revenue, oi.freight_value,\n","       p.product_category_name, p.product_weight_g\n","FROM order_items oi\n","JOIN orders o ON oi.order_id=o.order_id\n","JOIN products p ON oi.product_id=p.product_id\n","'''\n","sales = pd.read_sql(query, engine)\n","sales['order_purchase_timestamp'] = pd.to_datetime(sales['order_purchase_timestamp'])\n","sales['estimated_product_cost'] = sales['revenue'] * 0.65\n","sales['contribution'] = sales['revenue'] - sales['estimated_product_cost'] - sales['freight_value']\n","sales['freight_pct'] = sales['freight_value'] / sales['revenue']\n","sales.head()"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["delivered = sales[sales['order_status'].eq('delivered')].copy()\n","delivered['month'] = delivered['order_purchase_timestamp'].dt.to_period('M').astype(str)\n","monthly_revenue = delivered.groupby('month')['revenue'].sum()\n","monthly_revenue.plot(figsize=(12,5), title='Monthly Revenue')\n","plt.xticks(rotation=45)\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["q1 = delivered['freight_pct'].quantile(.25)\n","q3 = delivered['freight_pct'].quantile(.75)\n","iqr = q3-q1\n","upper_bound = q3 + 1.5*iqr\n","freight_outliers = delivered[delivered['freight_pct'] > upper_bound]\n","freight_outliers[['order_id','product_id','revenue','freight_value','freight_pct']].head()"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["reference_date = delivered['order_purchase_timestamp'].max()\n","rfm = delivered.groupby('customer_id').agg(\n","    recency=('order_purchase_timestamp', lambda x: (reference_date-x.max()).days),\n","    frequency=('order_id','nunique'),\n","    monetary=('revenue','sum')\n,").reset_index()\n","rfm.head()"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.x"}},"nbformat":4,"nbformat_minor":5}