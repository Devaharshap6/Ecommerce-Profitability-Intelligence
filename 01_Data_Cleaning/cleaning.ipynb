{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Data Cleaning & Validation\n","\n","The cleaning workflow validates the PostgreSQL source tables, standardizes dates, joins order-item level data, and derives modeled contribution and delivery metrics."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import pandas as pd\n","from sqlalchemy import create_engine\n","\n","engine = create_engine(\n","    'postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5433/ecommerce_profitability'\n,")"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["orders = pd.read_sql('SELECT * FROM orders', engine)\n","orders.shape, orders.info()"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["date_columns = ['order_purchase_timestamp','order_approved_at','order_delivered_carrier_date','order_delivered_customer_date','order_estimated_delivery_date']\n","for col in date_columns:\n","    orders[col] = pd.to_datetime(orders[col])\n","\n","orders['is_late'] = (orders['order_delivered_customer_date'] > orders['order_estimated_delivery_date']).astype('boolean')\n","orders.loc[orders['order_delivered_customer_date'].isna(), 'is_late'] = pd.NA"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["order_items = pd.read_sql('SELECT * FROM order_items', engine)\n","products = pd.read_sql('SELECT * FROM products', engine)\n","sellers = pd.read_sql('SELECT * FROM sellers', engine)\n","sales = order_items.merge(orders[['order_id','customer_id','order_status','order_purchase_timestamp','order_delivered_customer_date','order_estimated_delivery_date']], on='order_id', how='left')\n","sales = sales.merge(products[['product_id','product_category_name','product_weight_g','product_length_cm','product_height_cm','product_width_cm']], on='product_id', how='left')\n","sales = sales.merge(sellers[['seller_id','seller_city','seller_state']], on='seller_id', how='left')"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["sales['revenue'] = sales['price']\n","sales['estimated_product_cost'] = sales['revenue'] * 0.65\n","sales['estimated_contribution'] = sales['revenue'] - sales['estimated_product_cost'] - sales['freight_value']\n","sales['contribution_margin'] = (sales['estimated_contribution'] / sales['revenue']).replace([float('inf'), -float('inf')], pd.NA)\n","sales['delivery_days'] = (pd.to_datetime(sales['order_delivered_customer_date']) - pd.to_datetime(sales['order_purchase_timestamp'])).dt.days\n","sales['is_late'] = (pd.to_datetime(sales['order_delivered_customer_date']) > pd.to_datetime(sales['order_estimated_delivery_date'])).astype('boolean')\n","sales.loc[sales['order_delivered_customer_date'].isna(), 'is_late'] = pd.NA"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["sales.to_csv('../data/cleaned/sales_cleaned.csv', index=False)"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.x"}},"nbformat":4,"nbformat_minor":5}